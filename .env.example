# Copy to `.env` to customize your self-hosted FuLuoXiaoJie (弗洛小姐) instance.
# Never commit `.env` with real passphrases.

# Host interface binding:
# - 127.0.0.1 (default, safest with Tailscale Serve / Cloudflare Tunnel / Caddy)
# - 0.0.0.0   (direct access from phones/laptops on your home Wi-Fi LAN)
BIND_HOST=127.0.0.1
HOST_PORT=3000

# Optional initial passphrase (min 8 chars). Leave empty to set it interactively on first visit.
APP_PASSPHRASE=

# Optional: disable built-in passphrase login ONLY behind an upstream Zero Trust proxy (e.g. Cloudflare Access).
# AUTH_DISABLED=false

# Reverse-proxy headers:
# - Set TRUST_PROXY=true when serving via Tailscale Serve, Cloudflare Tunnel, or Caddy/Nginx.
# - Set TRUST_CLOUDFLARE_IP=true ONLY when behind Cloudflare Tunnel / Cloudflare Access.
TRUST_PROXY=false
TRUST_CLOUDFLARE_IP=false

# Session cookie lifetime in days (1..365)
SESSION_TTL_DAYS=30
